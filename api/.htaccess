Options -Indexes

RewriteEngine On
RewriteRule ^$ index.php [L]
RewriteRule ^health/?$ index.php?route=health [L,QSA]
RewriteRule ^private-health/?$ index.php?route=private-health [L,QSA]
RewriteRule ^sync/(push|pull|delete)/?$ index.php?route=sync/$1 [L,QSA]
RewriteRule ^provision/?$ index.php?route=provision [L,QSA]

<FilesMatch "^(config|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set Access-Control-Allow-Origin "https://calc.3direnzo.com.br"
  Header always set Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^ - [R=204,L]
</IfModule>

<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
